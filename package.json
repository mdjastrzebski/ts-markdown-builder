{
  "name": "ts-markdown-builder",
  "version": "0.6.0",
  "description": "Elegant Markdown builder for TypeScript: zero dependencies, tree-shakable, under 1 kB.",
  "main": "dist/commonjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "!**/__tests__",
    "!**/.*"
  ],
  "exports": {
    ".": {
      "require": "./dist/commonjs/index.js",
      "import": "./dist/esm/index.mjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "clean": "del-cli dist",
    "build": "pnpm clean && pnpm build:commonjs && pnpm build:esm && pnpm build:types",
    "build:commonjs": "BABEL_ENV=cjs babel src --out-dir \"dist/commonjs\" --extensions .js,.ts --out-file-extension .js --source-maps --no-comments",
    "build:esm": "BABEL_ENV=esm babel src --out-dir \"dist/esm\" --extensions .js,.ts --out-file-extension .mjs  --source-maps --no-comments",
    "build:types": "tsc --project tsconfig.release.json --outDir \"dist/types\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "validate:fix": "pnpm format && pnpm lint --fix && pnpm typecheck && pnpm test && pnpm build",
    "release": "release-it",
    "release:beta": "release-it --preRelease=beta"
  },
  "keywords": [
    "markdown",
    "typescript"
  ],
  "repository": "https://github.com/mdjastrzebski/ts-markdown-builder",
  "author": "Maciej Jastrzebski <mdjastrzebski@gmail.com> (https://github.com/mdjastrzebski)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mdjastrzebski/ts-markdown-builder/issues"
  },
  "homepage": "https://github.com/mdjastrzebski/ts-markdown-builder#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-modules-commonjs": "^7.29.14",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@release-it/conventional-changelog": "^12.0.2",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/jest": "^30.0.0",
    "babel-plugin-add-import-extension": "^1.6.0",
    "del-cli": "^8.0.1",
    "jest": "^30.5.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "release-it": "^21.1.2",
    "size-limit": "^14.3.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">= 18.0.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "pnpm typecheck",
        "pnpm test",
        "pnpm lint"
      ],
      "after:bump": "pnpm build",
      "after:release": "echo Successfully released ${name} v${version} to ${repo.repository}."
    },
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true,
      "releaseName": "v${version} (${date:yyyy-MM-dd})"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "✨ Features"
            },
            {
              "type": "perf",
              "section": "💨 Performance Improvements"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "chore(deps)",
              "section": "🛠️ Dependency Upgrades"
            },
            {
              "type": "docs",
              "section": "📚 Documentation"
            }
          ]
        }
      }
    }
  },
  "size-limit": [
    {
      "path": "./dist/esm/index.mjs",
      "limit": "1 kB"
    }
  ]
}
